{
  "expo": {
    "name": "Level OS",
    "slug": "level-os",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "../assets/icon-512.png",
    "scheme": "levelos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "7",
      "bundleIdentifier": "com.lvlos.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lvlos.app",
      "versionCode": 7,
      "googleServicesFile": "../frontend/android/app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#06110F",
        "foregroundImage": "../assets/icon-512.png",
        "monochromeImage": "../assets/icon-512.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "../assets/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "../assets/icon-512.png",
            "imageWidth": 96
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Level OS use o Face ID para proteger seu acesso."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
